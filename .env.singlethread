# Source before any run in this repo. Every numeric library below spawns its own
# thread pool by default -- torch alone took 8 of 12 cores -- and several running
# at once is what pins a laptop. One process, one thread, nice'd.
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export TORCH_NUM_THREADS=1
